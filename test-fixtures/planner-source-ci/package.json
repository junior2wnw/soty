{
  "name": "universal-planner",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mcp": "node --import tsx server/mcp-stdio.ts",
    "mcp:help": "node scripts/mcp-call.mjs planner_help",
    "mcp:list": "node scripts/mcp-call.mjs --list",
    "test:mcp": "node --max-old-space-size=512 --import tsx --test --test-concurrency=1 server/agent-service.test.ts server/mcp.test.ts",
    "dev": "node --import tsx server/main.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/main.ts --production",
    "test": "node --max-old-space-size=512 --import tsx --test --test-concurrency=1 shared/*.test.ts server/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src server shared *.json *.md *.html",
    "format:check": "prettier --check src server shared *.json *.md *.html"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "openid-client": "6.8.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
