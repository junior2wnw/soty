+++ b/src/server/managed-public-fence.ts
@@ -0,0 +1,23 @@
+import type { Express } from "express";
+import type { ReviewStore } from "./store.js";
+import { asyncRoute } from "./http.js";
+
+/** Public aliases must not disclose a private managed sibling even when a
+ * different placement in its site has been published. Native admin routes and
+ * explicit managed-authority routes do not run through this public projection. */
+export function registerManagedPublicFence(app: Express, store: ReviewStore) {
+  if (!store.isPublicSite || !store.isPublicObject) return;
+  app.use(["/api/public/:siteKey", "/v1/public/:siteKey"], asyncRoute(async (req, res, next) => {
+    const key = req.params.siteKey;
+    const site = typeof key === "string" ? await store.getSiteByKey(key) : undefined;
+    if (!site) { next(); return; } // Existing routes retain their exact not-found wire.
+    if (!await store.isPublicSite!(site.id)) { res.status(404).json({ error: "Not found" }); return; }
+    const match = req.path.match(/^\/objects\/([^/]+)(?:\/|$)/u);
+    if (match) {
+      let slug: string; try { slug = decodeURIComponent(match[1]); } catch { res.status(400).json({ error: "Invalid path" }); return; }
+      const object = await store.getObjectBySlug(slug, site.id);
+      if (object && !await store.isPublicObject!(object.id)) { res.status(404).json({ error: "Not found" }); return; }
+    }
+    next();
+  }));
+}
