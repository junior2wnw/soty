new file mode 100644
index 0000000..25e83fd
--- /dev/null
+++ b/src/server/managed-review-routes.ts
@@ -0,0 +1,23 @@
+import type { Express } from "express";
+import { asyncRoute } from "./http.js";
+import type { createManagedReviews } from "./managed-reviews.js";
+
+/** Optional Source RP composition. Native request authentication is supplied by
+ * a trusted verifier; the request body selects data within existing grants. */
+export function registerManagedReviewRoutes(app: Express, service?: ReturnType<typeof createManagedReviews>, publicUrl?: string) {
+  const origin = publicUrl ? new URL(publicUrl).origin : undefined;
+  const methods = { provision: "provision", context: "context", list: "list", collect: "collect", publish: "publish", moderate: "moderate" } as const;
+  for (const [path, method] of Object.entries(methods)) app.post("/api/managed/v1/" + path, asyncRoute(async (req, res) => {
+    res.setHeader("cache-control", "no-store");
+    if (!service) { res.status(503).json({ error: "managed_reviews_disabled" }); return; }
+    if (!origin || req.get("origin") !== origin) { res.status(403).json({ error: "managed_origin_required" }); return; }
+    const result = await service.withActor<unknown>(req, actor => service[method](actor, req.body)); res.json(result);
+  }));
+  app.post("/api/managed/v1/attach", asyncRoute(async (req, res) => {
+    res.setHeader("cache-control", "no-store");
+    if (!service) { res.status(503).json({ error: "managed_reviews_disabled" }); return; }
+    if (!origin || req.get("origin") !== origin) { res.status(403).json({ error: "managed_origin_required" }); return; }
+    res.json(await service.withActor(req, actor => service.attachLegacy(actor, req.body, req)));
+  }));
+  // There is deliberately no HTTP route for issuing/revoking Source tenant grants.
+}
