+test("exact case-sensitive app/project/person and tenant scope; foreign actor has no private context", async t => {
+  const f = await fixture(t), subjects = [appSubject, { kind: "project" as const, id: "Project-A" }, { kind: "person" as const, id: "Person-A" }]; await f.grant(subjects);
