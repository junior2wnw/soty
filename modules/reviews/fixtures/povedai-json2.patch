+      if (sameReviewOperation(existing, input)) return existing;
+      throw new ReviewOperationConflictError();
+    }
+  }
+  const now = nowIso();
+  const id = uid("rev");
+  const parent = input.parentId ? db.reviews.find((item) => item.id === input.parentId && item.objectId === canonicalObject.id) : undefined;
+  if (input.parentId && !parent) throw new Error("Parent review not found in this object");
+  if (parent?.status !== undefined && parent.status !== "approved") throw new Error("Cannot reply to a non-approved item");
+  let depth = 0;
+  let cursor = parent;
+  const seen = new Set<string>();
+  while (cursor) {
+    if (seen.has(cursor.id)) throw new Error("Parent thread is invalid");
+    seen.add(cursor.id);
+    depth += 1;
+    if (depth > (input.maxReplyDepth ?? 64)) throw new Error("Reply depth limit exceeded");
+    if (!cursor.parentId) break;
+    cursor = db.reviews.find((item) => item.id === cursor!.parentId && item.objectId === canonicalObject.id);
+    if (!cursor) throw new Error("Parent thread is invalid");
+  }
+  const review: Review = {
+    id,
+    objectId: canonicalObject.id,
+    subjectId: input.subjectId ?? subject.id,
+    originSiteId,
+    originObjectId: input.originObjectId ?? requestedObject.id,
+    type: parent ? "comment" : input.type ?? (input.rating ? "review" : "comment"),
+    parentId: input.parentId,
+    rootId: parent?.rootId ?? parent?.id ?? id,
+    depth,
+    version: 1,
+    channelId: input.channelId,
+    authorId: input.authorId,
+    externalId: input.externalId,
+    externalParentId: input.parentExternalId,
+    legacyId: input.legacyId,
+    source: input.source ?? "manual",
+    status: input.status ?? "approved",
+    publishedAt: (input.status ?? "approved") === "approved" ? now : undefined,
+    appearance: input.appearance ?? "standard",
+    appearanceMeta: input.appearanceMeta ?? {},
+    rating: input.rating,
+    title: input.title?.trim() || undefined,
+    pros: input.pros?.trim() || undefined,
+    cons: input.cons?.trim() || undefined,
+    trustOutcome: input.trustOutcome,
+    trustCause: input.trustCause,
+    trustProvenance: input.trustProvenance,
+    body: input.body.trim(),
+    author: {
+      ...input.author,
+      name: input.author.name.trim() || "Гость"
+    },
+    mediaUrls: input.mediaUrls ?? [],
+    tags: reviewTopicsEnabledForObject(canonicalObject.kind) ? normalizeReviewTopicTags(input.tags) : [],
+    inferredTags: reviewTopicsEnabledForObject(canonicalObject.kind) ? normalizeReviewTopicTags(input.inferredTags ?? inferReviewTopicTags(input)) : [],
+    excludedTags: reviewTopicsEnabledForObject(canonicalObject.kind) ? normalizeReviewTopicTags(input.excludedTags) : [],
+    up: input.up ?? 0,
+    down: input.down ?? 0,
+    aiAssisted: input.aiAssisted,
+    consentEvidence: input.consentEvidence ? structuredClone(input.consentEvidence) : undefined,
+    meta: input.meta ?? {},
+    createdAt: input.createdAt ?? now,
+    updatedAt: now
+  };
+  db.reviews.push(review);
+  appendJsonEvent(db, review, "item.created", ["*"]);
+  return review;
+}
+
+export function updateJsonReviewStatus(db: DatabaseFile, id: string, status: ReviewStatus) {
+  const review = db.reviews.find((item) => item.id === id);
+  if (!review) return undefined;
+  const previous = review.status;
+  review.status = status;
+  review.statusOverriddenAt = nowIso();
+  review.version = (review.version ?? 1) + 1;
+  if (status === "deleted") {
+    review.deletedAt = review.deletedAt ?? nowIso();
+    review.deletionKind = review.deletionKind ?? "moderator";
+  } else {
+    review.deletedAt = undefined;
+    review.deletedBy = undefined;
+    review.deleteReason = undefined;
+    review.deletionKind = undefined;
+    if (status === "approved") review.publishedAt = review.publishedAt ?? nowIso();
+  }
+  review.updatedAt = nowIso();
+  appendJsonEvent(db, review, status === "deleted" ? "item.deleted" : previous === "deleted" ? "item.restored" : "item.updated", ["status", "statusOverriddenAt"]);
+  return review;
+}
