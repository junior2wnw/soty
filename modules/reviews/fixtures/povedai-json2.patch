+++ b/src/server/managed-review-model.ts
@@ -0,0 +1,52 @@
+import crypto from "node:crypto";
+import { z } from "zod";
+
+export const MANAGED_REVIEW_PROTOCOL = "povedai.managed-reviews.v1";
+export const MANAGED_REVIEW_DOCUMENT_VERSION = 2;
+export const MANAGED_REVIEW_LIMITS = Object.freeze({ principals: 256, links: 512, grants: 256, bindings: 384, receipts: 10000 });
+export class ManagedReviewError extends Error { constructor(readonly code: string, readonly status = 400) { super(code); this.name = "ManagedReviewError"; } }
+export const managedNeed = (ok: unknown, code = "managed_review_invalid", status = 400) => { if (!ok) throw new ManagedReviewError(code, status); };
+export function exactManagedHash(value: unknown): string { return crypto.createHash("sha256").update(JSON.stringify(value), "utf8").digest("hex"); }
+export function wellFormedText(value: string) { return !/[\uD800-\uDBFF](?![\uDC00-\uDFFF])|(?<![\uD800-\uDBFF])[\uDC00-\uDFFF]/u.test(value); }
+const text = (maximum: number) => z.string().min(1).max(maximum).refine(value => wellFormedText(value) && !/[\u0000-\u001f\u007f]/u.test(value));
+export const managedIdSchema = text(200);
+export const managedIssuerSchema = text(1024).refine(value => { try { const url = new URL(value); return (url.protocol === "https:" || url.protocol === "http:") && !url.username && !url.password && !url.search && !url.hash; } catch { return false; } });
+const sha = z.string().regex(/^[a-f0-9]{64}$/);
+const iso = z.string().regex(/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/).refine(value => Number.isFinite(Date.parse(value)));
