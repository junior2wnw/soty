+++ b/src/server/managed-native-verifier.ts
@@ -0,0 +1,28 @@
+import type { Request } from "express";
+import type { Review } from "../shared/types.js";
+import type { ReviewStore } from "./store.js";
+import type { AdminAuthService } from "./admin-auth.js";
+import type { ReviewAuthService } from "./auth.js";
+import { reviewOwnedBySession } from "./public-author.js";
+import { managedNeed, managedIdSchema } from "./managed-review-model.js";
+import type { ManagedNativeVerifier } from "./managed-reviews.js";
+
+/** Reuses the ACTUAL native Source session checks. Identity linkage grants no
+ * native site/global role and never calls findOrCreateAuthor's email matcher. */
+export function createManagedNativeVerifier({ store, adminAuth, publicAuth }: { store: ReviewStore; adminAuth: AdminAuthService; publicAuth: ReviewAuthService }): ManagedNativeVerifier {
+  return Object.freeze({ async verify(credential: unknown, signal: AbortSignal) {
+    const req = credential as Request; managedNeed(req && typeof req.header === "function" && !signal.aborted, "managed_native_proof_invalid", 403);
+    const input = req.body as Record<string, unknown>; managedIdSchema.parse(input?.nativeId);
+    if (input.kind === "admin") {
+      const session = await adminAuth.session(req); managedNeed(session && session.user.id === input.nativeId && !signal.aborted, "managed_native_proof_invalid", 403);
+      return { kind: "admin" as const, nativeId: session!.user.id, authVersion: session!.user.authVersion, expiresAt: Math.min(Date.parse(session!.expiresAt), Date.now() + 3000) };
+    }
+    managedNeed(input.kind === "author", "managed_native_proof_invalid", 403); managedIdSchema.parse(input.siteId);
+    const site = await store.getSiteById(input.siteId as string); managedNeed(site, "managed_native_proof_invalid", 403);
+    const token = req.header("x-povedai-author-token"); managedNeed(typeof token === "string" && token.length <= 512, "managed_native_proof_invalid", 403);
+    const session = await publicAuth.verify(token, site!.key); managedNeed(session && !signal.aborted, "managed_native_proof_invalid", 403);
+    const author = await store.getAuthor(input.nativeId as string); managedNeed(author?.siteId === site!.id && !author.bannedAt, "managed_native_proof_invalid", 403);
+    managedNeed(await reviewOwnedBySession(store, { authorId: author!.id } as Review, session), "managed_native_proof_invalid", 403);
+    return { kind: "author" as const, nativeId: author!.id, siteId: site!.id, expiresAt: Math.min(Date.parse(session!.expiresAt), Date.now() + 3000) };
+  } });
+}
