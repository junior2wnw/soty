diff --git a/src/server/atomic-json-document.ts b/src/server/atomic-json-document.ts
new file mode 100644
index 0000000..9106314
--- /dev/null
+++ b/src/server/atomic-json-document.ts
@@ -0,0 +1,147 @@
+import crypto from "node:crypto";
+import { constants } from "node:fs";
+import { lstat, mkdir, open, realpath, rename, unlink } from "node:fs/promises";
+import type { FileHandle } from "node:fs/promises";
+import path from "node:path";
+
+export const ATOMIC_JSON_PROFILE = "povedai.atomic-json-document.v1";
+export interface AtomicJsonOptions { maxBytes?: number; lockTimeoutMs?: number; }
+interface LockRecord { profile: typeof ATOMIC_JSON_PROFILE; pid: number; nonce: string; }
+export class AtomicDocumentError extends Error {
+  constructor(readonly code: string) { super(code); this.name = "AtomicDocumentError"; }
+}
+const need = (ok: unknown, code: string) => { if (!ok) throw new AtomicDocumentError(code); };
+const absent = (error: unknown) => (error as NodeJS.ErrnoException)?.code === "ENOENT";
+
+/** One document is the Source commit boundary. Every native and managed writer
+ * must use this port; a second per-instance queue is not a process lock.
+ * A dead writer's lock is retained until the explicit checked recovery method.
+ * Windows reports file-sync/atomic replace, not a Unix directory-sync guarantee. */
+export class AtomicJsonDocument {
+  readonly filePath: string;
+  readonly lockPath: string;
+  private readonly maxBytes: number;
+  private readonly lockTimeoutMs: number;
+  constructor(filePath: string, options: AtomicJsonOptions = {}) {
+    need(typeof filePath === "string" && filePath.length > 0, "document_path_invalid");
+    this.filePath = path.resolve(filePath); this.lockPath = this.filePath + ".writer-lock";
+    this.maxBytes = options.maxBytes ?? 128 * 1024 * 1024;
+    this.lockTimeoutMs = options.lockTimeoutMs ?? 3000;
+    need(Number.isSafeInteger(this.maxBytes) && this.maxBytes >= 65536 && this.maxBytes <= 128 * 1024 * 1024, "document_limits_invalid");
+    need(Number.isSafeInteger(this.lockTimeoutMs) && this.lockTimeoutMs >= 10 && this.lockTimeoutMs <= 10000, "document_limits_invalid");
+  }
+  private async directory() {
+    const directory = path.dirname(this.filePath); await mkdir(directory, { recursive: true, mode: 0o700 });
+    const resolved = path.resolve(await realpath(directory));
+    need(process.platform === "win32" ? resolved.toLowerCase() === directory.toLowerCase() : resolved === directory, "document_path_unsafe");
+    const info = await lstat(directory); need(info.isDirectory() && !info.isSymbolicLink(), "document_path_unsafe");
+    return directory;
+  }
+  private async readFile(file: string, maximum: number): Promise<{ bytes: Buffer; inode: number; device: number }> {
+    const before = await lstat(file);
+    need(before.isFile() && !before.isSymbolicLink() && before.nlink === 1 && before.size <= maximum, "document_file_unsafe");
+    const handle = await open(file, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
+    try {
+      const info = await handle.stat();
+      need(info.isFile() && info.nlink === 1 && info.size <= maximum && info.dev === before.dev && info.ino === before.ino, "document_file_unsafe");
+      const chunks: Buffer[] = []; let total = 0;
+      for (;;) {
+        const buffer = Buffer.alloc(Math.min(65536, maximum + 1 - total));
+        const { bytesRead } = await handle.read(buffer, 0, buffer.length, null);
+        if (!bytesRead) break; total += bytesRead;
+        need(total <= maximum, "document_capacity"); chunks.push(buffer.subarray(0, bytesRead));
+      }
+      const current = await lstat(file);
+      need(!current.isSymbolicLink() && current.dev === info.dev && current.ino === info.ino, "document_file_changed");
+      return { bytes: Buffer.concat(chunks, total), inode: info.ino, device: info.dev };
+    } finally { await handle.close(); }
+  }
+  private async acquire(): Promise<{ record: LockRecord; inode: number; device: number }> {
+    await this.directory(); const deadline = performance.now() + this.lockTimeoutMs;
+    for (;;) {
+      need(performance.now() < deadline, "document_busy");
+      const record: LockRecord = { profile: ATOMIC_JSON_PROFILE, pid: process.pid, nonce: crypto.randomBytes(16).toString("hex") };
+      try {
+        const handle = await this.openLock();
+        try { await handle.writeFile(JSON.stringify(record)); await handle.sync();
+          const info = await handle.stat(); return { record, inode: info.ino, device: info.dev };
+        } finally { await handle.close(); }
+      } catch (error) {
+        const code = (error as NodeJS.ErrnoException).code;
+        const windowsDeletePending = process.platform === "win32" && code === "EPERM";
+        if (code !== "EEXIST" && !windowsDeletePending) throw error;
+        // Windows can report EPERM instead of EEXIST during delete-pending.
+        // Only lock CREATION is retried, before any domain callback or write.
+        // A persistent permissions problem times out without changing ACLs.
+        let info; try { info = await lstat(this.lockPath); } catch (changed) {
+          if (absent(changed)) { await new Promise(resolve => setTimeout(resolve, 10)); continue; } throw changed;
+        }
+        need(info.isFile() && !info.isSymbolicLink() && info.nlink === 1, "document_lock_unsafe");
+        need(performance.now() < deadline, "document_busy");
+        await new Promise(resolve => setTimeout(resolve, 10));
+      }
+    }
+  }
+  /** Narrow syscall seam for deterministic transport regression. Production
+   * uses exactly this exclusive creation; no data/config selects another port. */
+  protected openLock() { return open(this.lockPath, "wx", 0o600); }
+  private async release(lock: { record: LockRecord; inode: number; device: number }) {
+    const current = await this.readFile(this.lockPath, 1024);
+    need(current.inode === lock.inode && current.device === lock.device && current.bytes.toString("utf8") === JSON.stringify(lock.record), "document_lock_changed");
+    await unlink(this.lockPath);
+  }
+  private async snapshot<T>(): Promise<T | undefined> {
+    try {
+      const { bytes } = await this.readFile(this.filePath, this.maxBytes);
+      let text: string;
+      try { text = new TextDecoder("utf-8", { fatal: true }).decode(bytes); } catch { throw new AtomicDocumentError("document_encoding_invalid"); }
+      try { return JSON.parse(text) as T; } catch { throw new AtomicDocumentError("document_json_invalid"); }
+    } catch (error) { if (absent(error)) return undefined; throw error; }
+  }
+  private async replace(value: unknown) {
+    const bytes = Buffer.from(JSON.stringify(value, null, 2), "utf8");
+    need(bytes.length <= this.maxBytes, "document_capacity");
+    const temporary = this.filePath + "." + crypto.randomBytes(16).toString("hex") + ".tmp";
+    let handle: FileHandle | undefined = await open(temporary, "wx", 0o600);
+    try { await handle.writeFile(bytes); await handle.sync(); await handle.close();
+      handle = undefined;
+      // Windows may transiently hold an antivirus handle. Retrying the same
+      // atomic replace does not retry a domain operation or rerun a callback.
+      for (let attempt = 0;; attempt++) {
+        try { await rename(temporary, this.filePath); break; }
+        catch (error) { if ((error as NodeJS.ErrnoException).code !== "EPERM" || attempt >= 5) throw error;
+          await new Promise(resolve => setTimeout(resolve, 25 * 2 ** attempt)); }
+      }
+      if (process.platform !== "win32") { const directory = await open(path.dirname(this.filePath), constants.O_RDONLY);
+        try { await directory.sync(); } finally { await directory.close(); } }
+    } finally { if (handle) await handle.close(); await unlink(temporary).catch(error => { if (!absent(error)) throw error; }); }
+  }
+  async read<T>(): Promise<T | undefined> {
+    const lock = await this.acquire(); try { return await this.snapshot<T>(); } finally { await this.release(lock); }
+  }
+  async transact<T, R>(callback: (current: T | undefined) => { document: T; result: R }): Promise<R> {
+    const lock = await this.acquire();
+    try {
+      const outcome = callback(await this.snapshot<T>());
+      need(outcome && typeof outcome === "object" && !(outcome as unknown as { then?: unknown }).then, "document_async_commit_forbidden");
+      await this.replace(outcome.document); return outcome.result;
+    } finally { await this.release(lock); }
+  }
+  /** Exact metadata witness only, never secret document content or a time lease.
+   * Explicit recovery refuses a live PID (including a reused PID), then compares
+   * inode/device/full nonce record again before unlink. Run only with writers
+   * quiesced; concurrent recovery tools are not an automatic failover protocol. */
+  async inspectLock() {
+    const value = await this.readFile(this.lockPath, 1024);
+    const record = JSON.parse(value.bytes.toString("utf8")) as LockRecord;
+    need(record.profile === ATOMIC_JSON_PROFILE && Number.isSafeInteger(record.pid) && record.pid > 0 && /^[a-f0-9]{32}$/.test(record.nonce), "document_lock_unsafe");
+    return Object.freeze({ ...record, inode: value.inode, device: value.device });
+  }
+  async recoverDeadOwner(expected: Awaited<ReturnType<AtomicJsonDocument["inspectLock"]>>) {
+    const current = await this.inspectLock(); need(JSON.stringify(current) === JSON.stringify(expected), "document_lock_changed");
+    let dead = false; try { process.kill(current.pid, 0); } catch (error) { dead = (error as NodeJS.ErrnoException).code === "ESRCH"; }
+    need(dead, "document_owner_not_proven_dead");
+    const again = await this.inspectLock(); need(JSON.stringify(current) === JSON.stringify(again), "document_lock_changed");
+    await unlink(this.lockPath); return Object.freeze({ recovered: true });
+  }
+}
