{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufanovostroyka.ru/schemas/identity/v1/workflow-exchange-record.schema.json",
  "title": "Canonical one-time workflow exchange record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "exchange_id",
    "source_client_id",
    "target_client_id",
    "target_origin",
    "purpose",
    "state",
    "status",
    "subject_id",
    "organization_id",
    "resources",
    "issued_at",
    "expires_at",
    "code_hash",
    "consumed_at"
  ],
  "properties": {
    "schema": { "const": "identity.workflow-exchange-record.v1" },
    "exchange_id": { "$ref": "#/$defs/exchange_id" },
    "source_client_id": { "$ref": "#/$defs/client_id" },
    "target_client_id": { "$ref": "#/$defs/client_id" },
    "target_origin": {
      "type": "string",
      "minLength": 12,
      "maxLength": 255,
      "format": "uri",
      "pattern": "^https://[^/?#@]+$"
    },
    "purpose": { "const": "account_link" },
    "state": {
      "type": "string",
      "minLength": 22,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "status": { "enum": ["issued", "consumed"] },
    "subject_id": { "$ref": "#/$defs/subject_id" },
    "organization_id": { "$ref": "#/$defs/organization_id" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/resource" }
    },
    "issued_at": { "$ref": "#/$defs/date_time" },
    "expires_at": { "$ref": "#/$defs/date_time" },
    "code_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "consumed_at": {
      "oneOf": [
        { "$ref": "#/$defs/date_time" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "issued" } } },
      "then": { "properties": { "consumed_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "consumed" } } },
      "then": { "properties": { "consumed_at": { "$ref": "#/$defs/date_time" } } }
    }
  ],
  "$defs": {
    "date_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "client_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "exchange_id": {
      "type": "string",
      "minLength": 10,
      "maxLength": 132,
      "pattern": "^xchg_[A-Za-z0-9_-]{5,127}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 132,
      "pattern": "^sub_[A-Za-z0-9_-]{5,127}$"
    },
    "organization_id": {
      "type": "string",
      "minLength": 9,
      "maxLength": 132,
      "pattern": "^org_[A-Za-z0-9_-]{5,127}$"
    },
    "stable_id": {
      "type": "string",
      "minLength": 7,
      "maxLength": 132,
      "pattern": "^[a-z][a-z0-9]*_[A-Za-z0-9][A-Za-z0-9_-]{4,127}$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": ["organization", "project", "feed_connection", "verification_case"]
        },
        "id": { "$ref": "#/$defs/stable_id" }
      }
    }
  }
}
