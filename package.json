{
  "name": "soty-online-tunnel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/build-agent-release.mjs",
    "build": "vite build",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "agent": "node scripts/soty-agent.mjs",
    "ctl": "node scripts/soty-agent.mjs ctl",
    "codex:runtime:update": "node scripts/update-codex-runtime.mjs",
    "codex:runtime:latest": "node scripts/update-codex-runtime.mjs --print-latest",
    "agent:release": "node scripts/build-agent-release.mjs",
    "agent:release:check": "node scripts/agent-release/check.mjs",
    "agent:sign:windows": "powershell -ExecutionPolicy Bypass -File scripts/agent-release/sign-windows.ps1",
    "agent:selftest": "node scripts/action-kernel-selftest.mjs",
    "payments:selftest": "node scripts/payment-selftest.mjs",
    "agent:eval": "node scripts/soty-agent-eval.mjs",
    "element:init": "node scripts/element-upstream.mjs init",
    "element:status": "node scripts/element-upstream.mjs status",
    "element:update": "node scripts/element-upstream.mjs update",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "express": "^4.19.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "trustlink-kernel": "git+https://github.com/junior2wnw/4-2-rf.git#b6cd753122ef67a6202896dd9ae73a53d669d4b5",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
