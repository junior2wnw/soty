{
  "name": "soty-online-tunnel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "type": "module",
  "scripts": {
    "connect:test": "node --test modules/connect/test/*.test.mjs",
    "platform:test": "node --test modules/app-contract/test/*.test.mjs modules/feedback/test/*.test.mjs modules/human-identity/test/*.test.mjs modules/reviews/test/*.test.mjs modules/capabilities/test/adapters.test.mjs modules/capabilities/test/external-adapters.test.mjs",
    "capabilities:test": "node --test modules/capabilities/test/*.test.mjs server/test/capabilities-*.test.mjs scripts/executor-policy.test.mjs",
    "world:test": "node --test --test-concurrency=2 modules/field/*.test.mjs modules/world/test/*.test.mjs modules/apps/test/*.test.mjs modules/notes/test/*.test.mjs server/test/*.test.mjs src/world/*.test.mjs src/geometry/*.test.mjs src/world/theme/*.test.mjs src/platform/*.test.mjs src/transport/*.test.mjs",
    "dev:test": "node --test scripts/dev.test.mjs",
    "connect:release:test": "node --test deploy/connect/*.test.mjs",
    "connect:update": "node modules/connect/update/cli.mjs",
    "connect:example": "node modules/connect/examples/server.mjs",
    "dev": "node scripts/dev.mjs",
    "prebuild": "node scripts/build-agent-release.mjs",
    "build": "vite build",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "agent": "node scripts/soty-connector.mjs",
    "agent:ctl": "node scripts/soty-connector.mjs ctl",
    "agent:release": "node scripts/build-agent-release.mjs",
    "traffic:selftest": "node scripts/traffic-tunnel-proxy-selftest.mjs && node scripts/traffic-core-selftest.mjs",
    "traffic:smoke": "node scripts/traffic-live-smoke.mjs",
    "agent:selftest": "node scripts/build-agent-release.mjs && node scripts/agent-release-selftest.mjs && node scripts/agent-update-selftest.mjs && node scripts/opencode-model-selftest.mjs && node scripts/connector-store-selftest.mjs && node scripts/gonka-proxy-selftest.mjs && node scripts/spreadex-ml-selftest.mjs",
    "agent:release:selftest": "node scripts/build-agent-release.mjs && node scripts/agent-release-selftest.mjs && node scripts/agent-update-selftest.mjs",
    "spreadex:selftest": "node scripts/spreadex-ml-selftest.mjs",
    "spreadex:release:sign": "node scripts/sign-spreadex-ml-release.mjs",
    "agent:integration": "node scripts/connector-integration-selftest.mjs",
    "agent:proxy:smoke": "node scripts/gonka-proxy-live-smoke.mjs",
    "inference:selftest": "node scripts/gonka-proxy-selftest.mjs && node scripts/model-aliases-selftest.mjs && node scripts/minimax-contract-selftest.mjs && node scripts/inference-resilience-selftest.mjs && node scripts/inference-race-keys-selftest.mjs && node scripts/deepseek-routing-selftest.mjs",
    "connector": "node scripts/soty-connector.mjs",
    "ctl": "node scripts/soty-connector.mjs ctl",
    "connector:release": "node scripts/build-agent-release.mjs",
    "connector:selftest": "node scripts/build-agent-release.mjs && node scripts/agent-release-selftest.mjs && node scripts/agent-update-selftest.mjs && node scripts/opencode-model-selftest.mjs && node scripts/connector-store-selftest.mjs && node scripts/gonka-proxy-selftest.mjs",
    "connector:integration": "node scripts/connector-integration-selftest.mjs",
    "identity:selftest": "node scripts/soty-identity-adapter-selftest.mjs && node scripts/identity-wire-v1-selftest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "app:release": "node scripts/soty-app-release.mjs",
    "app:release:test": "node --test deploy/apps/*.test.mjs",
    "app-art": "node scripts/app-art/cli.mjs",
    "app-art:prepare": "node scripts/app-art/cli.mjs prepare",
    "app-art:import": "node scripts/app-art/cli.mjs import",
    "app-art:validate": "node scripts/app-art/cli.mjs validate",
    "app-art:list": "node scripts/app-art/cli.mjs list",
    "app-art:test": "node --test scripts/app-art/*.test.mjs src/world/app-art.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/server": "2.2.0",
    "chess.js": "^1.4.0",
    "express": "^4.19.2",
    "jsqr": "^1.4.0",
    "oidc-provider": "9.12.2",
    "qrcode": "^1.5.4",
    "tldts": "7.4.16",
    "trustlink-kernel": "git+https://github.com/junior2wnw/4-2-rf.git#082f47242177b56ac2548c3c5b8e8c264dbae500",
    "ws": "^8.18.0",
    "yjs": "^13.6.21"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.5.12",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "sharp": "0.34.5"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
