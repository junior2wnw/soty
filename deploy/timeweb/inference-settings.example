# Apply these values to the existing protected online-chat.env, preserving all
# application tokens and every unrelated setting. Supply both provider keys
# privately; do not paste them into shell arguments or commit them.
SOTY_GONKA_BASE_URL=https://gate.joingonka.ai/v1
SOTY_GONKA_UPSTREAM_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
SOTY_GONKA_FALLBACK_BASE_URL=https://api.openbroker.gonka.gg/v1
# Each request selects its own model. This value is only the default in legacy health metadata.
# '*' allows the secondary for all models; 'none' disables it; canonical IDs restrict it.
SOTY_GONKA_FALLBACK_MODELS=*
# race: send to both, return the first valid result, cancel the loser (both can bill).
# fallback: only send to the secondary if the primary fails before visible output.
SOTY_GONKA_PROVIDER_STRATEGY=race
SOTY_GONKA_EMPTY_TOOL_FALLBACK=1
SOTY_GONKA_REQUEST_TIMEOUT_MS=55000
# 45s in race mode allows slow prefills within the shared 55s deadline.
# When switching to fallback, use 20s so the secondary still has time to respond.
SOTY_GONKA_FIRST_TOKEN_TIMEOUT_MS=45000
SOTY_GONKA_IDLE_TIMEOUT_MS=30000
SOTY_GONKA_STREAM_TIMEOUT_MS=1800000
SOTY_GONKA_PROVIDER_CONCURRENCY=8
SOTY_GONKA_MAX_QUEUED=64
SOTY_GONKA_QUEUE_WAIT_MS=5000
SOTY_GONKA_INTERNAL_STREAM=1
SOTY_GONKA_LOG_METRICS=1
